# NextAuth / Auth.js Secret (Chuỗi ngẫu nhiên bí mật dùng để mã hóa và ký JWT token)
# Tạo bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=class_deadline_hub_super_secret_jwt_key_2026_ptit

# URL gốc của ứng dụng (dùng cho NextAuth nhận biết callbackUrl và base domain)
NEXTAUTH_URL=http://localhost:3000

# Base URL dùng cho metadata, SEO canonical, sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cổng lắng nghe
PORT=3000

# (Tùy chọn) Cấu hình GitHub OAuth:
# Lấy từ GitHub Developer Settings: Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Homepage URL: http://localhost:3000 (hoặc URL production trên Vercel)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=your_github_oauth_client_id
GITHUB_SECRET=your_github_oauth_client_secret
